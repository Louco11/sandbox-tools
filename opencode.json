{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "sandbox": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "exec \"$(git rev-parse --show-toplevel)/bin/sandbox-mcp\" platform"
      ],
      "enabled": true
    },
    "sandbox-team-load": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "exec \"$(git rev-parse --show-toplevel)/bin/sandbox-mcp\" tool team-load"
      ],
      "enabled": true
    }
  }
}
